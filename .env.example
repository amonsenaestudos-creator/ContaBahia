# Banco PostgreSQL local (fallback do formulário sem Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase — execute supabase/schema.sql e mantenha a service role somente no servidor
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=substitua-pela-chave-real
BLOG_ADMIN_TOKEN=substitua-por-um-token-forte

